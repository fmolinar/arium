# Address the HTTP server listens on
ADDRESS=:8080

# Origin allowed to make cross-origin requests (CORS)
FRONTEND_URL=http://localhost:3000

# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/arium

# MongoDB database name
MONGO_DB=arium

# Secret used to sign and verify JWTs (required)
JWT_SECRET=

# Log level for the JSON logs on stdout: debug, info, warn or error
LOG_LEVEL=info

# Serve Prometheus metrics at /metrics on this address; empty disables
METRICS_ADDRESS=:9464
