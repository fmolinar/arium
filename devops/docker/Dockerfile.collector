# Build stage
FROM golang:1.25-alpine AS builder

WORKDIR /src

COPY backend/go.mod backend/go.sum ./
RUN go mod download

COPY backend/ ./
RUN CGO_ENABLED=0 GOOS=linux go build -o /out/collector ./cmd/collector

# Runtime stage
FROM alpine:3.22

# ca-certificates: every source is fetched over HTTPS.
# /data is created owned by the app user so a fresh named volume mounted there
# inherits that ownership and the non-root process can write to it.
RUN apk add --no-cache ca-certificates && \
    addgroup -S app && adduser -S app -G app && \
    mkdir /data && chown app:app /data

WORKDIR /app
COPY --from=builder /out/collector ./collector

USER app

ENV COLLECTOR_OUT_DIR=/data
VOLUME /data

ENTRYPOINT ["./collector"]
