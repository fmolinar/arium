# Copy this file to .env in the same directory (devops/docker/.env) and
# fill in real values. docker compose loads it automatically from here.

# Secret used by the backend to sign and verify JWTs (required)
JWT_SECRET=

# MongoDB the backend reads from (optional). Leave unset for the local mongo
# service, or set the Atlas connection string the Lambda collector writes to
# (devops/terraform) so the frontend shows that data:
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/arium?retryWrites=true&w=majority
# MONGO_DB=arium

# News collector run policy (optional; defaults shown)
# COLLECTOR_SCHEDULE=00:00,08:00,16:00   # daily run times, 24-hour HH:MM
# COLLECTOR_TIMEZONE=UTC                 # e.g. America/Los_Angeles
# COLLECTOR_RUN_ON_START=true            # also collect once when the container starts
# COLLECTOR_RETENTION=720h               # keep 30 days of data
# COLLECTOR_SINCE=168h                   # ignore articles older than 7 days (must be <= retention)
# COLLECTOR_SOURCE_TIMEOUT=15s           # give up on a single source after this long

# Logging and observability (optional; defaults shown)
# LOG_LEVEL=info                         # backend and collector: debug, info, warn or error
# GRAFANA_ADMIN_PASSWORD=admin           # Grafana at http://localhost:3001, user admin
# PROMETHEUS_RETENTION=15d               # how long Prometheus keeps metrics

# Public domain through a Cloudflare Tunnel (optional). Create the tunnel in the
# Cloudflare dashboard (Zero Trust > Networks > Tunnels), add a public hostname
# for your domain pointing at http://app:4173, and paste its token here.
# COMPOSE_PROFILES=tunnel                # starts the cloudflared service
# CLOUDFLARE_TUNNEL_TOKEN=
# PUBLIC_HOSTNAME=arium.example.com      # vite preview rejects other hostnames
# FRONTEND_URL=https://arium.example.com # backend CORS origin
