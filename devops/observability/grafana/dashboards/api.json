{
  "uid": "arium-api",
  "title": "Arium API",
  "description": "RED metrics (rate, errors, duration) for the Go API, per chi route.",
  "tags": [
    "arium",
    "api"
  ],
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "graphTooltip": 1,
